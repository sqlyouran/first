# ===== WanderChina 生产环境变量模板 =====
# 用法：在 ECS 服务器上复制为 .env.production 并填入真实值。
#   cp .env.production.example .env.production
# .env.production 含生产密钥，已在 .gitignore 中排除，切勿提交。

# ---- 数据库（阿里云 RDS）----
DB_HOST=your-rds-endpoint.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=wanderchina
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# RDS 走公网/内网均建议开启 SSL
DB_USE_SSL=true

# ---- JWT 密钥（生产必须替换）----
# 生成命令：openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_RANDOM_48_CHAR_SECRET

# ---- CORS 允许来源（你的正式域名，逗号分隔）----
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ---- AI（通义千问 DashScope）----
DASHSCOPE_API_KEY=your_dashscope_api_key
# 汇率 API（可选功能）
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# ---- Spring Profile ----
SPRING_PROFILES_ACTIVE=prod

# ---- 以下为 Docker 内网服务地址，docker-compose.yml 已默认注入，
#      通常无需改动；此处列出便于排查 ----
# MCP Client 生产关闭（容器内无 npx）
MCP_CLIENT_ENABLED=false
REDIS_HOST=redis
CHROMA_HOST=http://chroma
CHROMA_PORT=8000
# 前端 SSR 通过内网直连后端
BACKEND_URL=http://backend:8080
