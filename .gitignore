# OS
.DS_Store
Thumbs.db

# Screenshots (dev artifacts)
*.png

# Editors
.vscode/
.idea/
*.iml
*.swp
*.swo

# Logs
*.log
logs/

# Dependencies (Java + Node)
node_modules/
__pycache__/
*.pyc
target/
dist/
build/

# Env
.env
.env.local
# 生产密钥文件不入库（.env.production.example 模板仍追踪）
.env.production

# SSL 证书不入库（由 scripts/init-ssl.sh 在服务器生成）
nginx/ssl/*.pem

# 数据采集产出物（本地临时文件，不上传仓库）
output/

# Chroma 向量库本地数据（启动时自动重建）
chroma/
chroma_data/
chroma.log

# OpenSpec init 前的脚手架备份（确认无用后可手工删除）
openspec.scaffold.bak/

# submodule 迁移中产生的本地残留（验证远端后手工删除）
backend.bak/
frontend.bak/
frontend.junk/
